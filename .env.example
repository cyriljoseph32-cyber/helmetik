# Public site URL used for canonical/OG/sitemap. Set to your production domain.
NEXT_PUBLIC_SITE_URL=https://helmetik.com

# Google Maps Platform API key (Maps JavaScript API) for the Locations map.
# Restrict it to your domain(s) in the Google Cloud console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# OPTIONAL — email delivery for Contact / Become-a-host forms.
# Until this is set, forms fall back to the WhatsApp deep-link flow (which always works).
# Create a key at https://resend.com and verify a sending domain.
RESEND_API_KEY=

# Address that form submissions are emailed to (defaults to info@helmetik.com).
CONTACT_INBOX=info@helmetik.com
